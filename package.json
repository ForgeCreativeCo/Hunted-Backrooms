{
  "name": "hum",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,client -c magenta,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts --port 8787",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "preview": "vite preview",
    "sim": "tsx scripts/sim.ts",
    "net-test": "tsx scripts/net-test.ts"
  },
  "dependencies": {
    "three": "0.169.0",
    "tsx": "4.19.2",
    "ws": "8.18.0"
  },
  "devDependencies": {
    "@types/node": "22.9.0",
    "@types/three": "0.169.0",
    "@types/ws": "8.5.13",
    "concurrently": "9.1.0",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
